
PROGRAM Part10
{

    function fib(n: int) {
        if n < 1 {
            return 0;
        }
        elif n < 3 {
            return 1;
        }
        return fib(n - 1) + fib(n - 2);
    }

    var x: int;
    for i = 0; i < 10; i = i + 1 {
        x = max(x, fib(i));
    }

    print(x);

    function abc() {
        function cba() {
            return 1;
        }
        return cba;
    }

    var a: int = 1;
    var b: int = 5;

    while (a <= b) {
        print(a);
        if a >= 3 {
            break;
        }
        a = a + 1;
    }
}