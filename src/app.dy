
PROGRAM Part10
{

    function test {
        return 2;
    }

    function fib(n: int) {
        if n < 1 {
            return 0;
        }
        elif n < 3 {
            return 1;
        }
        return fib(n - 1) + fib(n - 2);
    }

    function trueFunc() {
        return true;
    }

    function falseFunc() {
        return false;
    }

    var x: int;
    for i = 0; i < 10; i = i + 1 {
        x = max(x, fib(i));
    }

    function foo {}

    for i = 0; i < 10000; i = i + 1 {
        foo();
    }

    print(x);
}